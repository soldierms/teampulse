# Copy to .env and fill in. Never commit .env.

# --- Database ---
POSTGRES_USER=teampulse
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=teampulse
DATABASE_URL=postgresql+psycopg://teampulse:change-me-locally@db:5432/teampulse

# --- App ---
# Signs session tokens. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Encrypts integration credentials at rest. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=
SESSION_TTL_HOURS=720
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# --- PagerDuty ---
# Leave blank to run against the bundled mock provider instead.
PAGERDUTY_API_KEY=
PAGERDUTY_CLIENT_ID=
PAGERDUTY_CLIENT_SECRET=

# --- GitHub ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URL=http://localhost:8001/api/integrations/github/callback

# --- Sync / jobs ---
SYNC_INTERVAL_MINUTES=15
WORKER_POLL_SECONDS=5

# --- Weekly digest ---
# console | smtp | resend | slack
NOTIFIER=console
DIGEST_FROM_EMAIL=teampulse@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
RESEND_API_KEY=
SLACK_WEBHOOK_URL=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8001
